		<Item class="LocalScript" referent="RBX5">
			<Properties>
				<bool name="Disabled">false</bool>
				<string name="Name">BladeController</string>
				<string name="Source">-- Pulse Blade Controller
-- Simple version to start

local Tool = script.Parent
local Handle = Tool:WaitForChild("Handle")
local BladeMesh = Handle:WaitForChild("BladeMesh")
local BladeLight = Handle:WaitForChild("BladeLight")
local BladeTrail = Handle:WaitForChild("BladeTrail")

local isCharging = false
local chargeLevel = 0
local chargeStartTime = 0

local function updateBlade()
	local brightness = 0.2 + (chargeLevel * 0.8)
	BladeLight.Brightness = brightness * 3
	BladeLight.Color = Color3.new(0, 0.4 + chargeLevel * 0.6, 0.8 + chargeLevel * 0.2)
	BladeMesh.Scale = Vector3.new(0.2 + chargeLevel * 0.3, 0.2 + chargeLevel * 0.3, 2)
	BladeTrail.Enabled = chargeLevel > 0.1
end

Tool.Activated:Connect(function()
	isCharging = true
	chargeStartTime = tick()
	
	local connection
	connection = game:GetService("RunService").RenderStepped:Connect(function()
		if not isCharging then
			connection:Disconnect()
			return
		end
		local elapsed = tick() - chargeStartTime
		chargeLevel = math.min(elapsed * 0.5, 1.0) -- Charge over 2 seconds
		updateBlade()
	end)
	
	wait(0.1) -- Minimum charge time
	isCharging = false
	if connection then connection:Disconnect() end
	
	-- Simple strike effect
	BladeLight.Brightness = 5
	wait(0.1)
	updateBlade()
end)
</Source>
			</Properties>
		</Item>
	</Item>
